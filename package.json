{
  "name": "sql-detective-tw",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "img": "node scripts/optimize-image.js",
    "dev": "tailwindcss -i ./src/tailwind.css -o ./css/style.css --watch",
    "build": "tailwindcss -i ./src/tailwind.css -o ./css/style.css --minify",
    "data": "node scripts/gen-data.js",
    "tasks": "node scripts/build-tasks.js",
    "test:compat": "node scripts/test-compat.js",
    "favicon": "node scripts/make-favicon.js",
    "serve": "serve . -l 3000",
    "prebuild": "node scripts/gen-data.js && node scripts/build-tasks.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "gsap": "^3.15.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.1.0"
  },
  "description": "SQL 偵探事務所：潮港市檔案 — 以 MariaDB 語法為基準的互動式 SQL 教學遊戲"
}
